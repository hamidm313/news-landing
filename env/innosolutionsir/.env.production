# Points this landing site's static-export production build at the real
# innosolutionsir backend (cmms-backend/php, PROJECT=innosolutionsir --
# news content, see that repo's env/innosolutionsir/.env.production). Read
# by scripts/build-static.mjs, not by plain `next build`/`next dev`.
NEXT_PUBLIC_API_BASE=https://api.innosolutions.ir
